# Server
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=smm-designs
R2_PUBLIC_BASE=https://pub-xxxx.r2.dev

# Meta Graph API (Facebook + Instagram)
META_APP_ID=000000000000000
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_GRAPH_VERSION=v19.0
# In the Meta App dashboard, add this as a Valid OAuth Redirect URI:
#   http://localhost:4000/api/oauth/meta/callback

# Resend (transactional email) — leave blank to disable email notifications
RESEND_API_KEY=
RESEND_FROM=SMM <notifications@yourdomain.com>

# Slack — agency-wide channel; leave blank to disable team notifications
SLACK_WEBHOOK_URL=

# Stripe billing — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure the webhook in Stripe Dashboard pointing to:
#   https://your-host/api/billing/webhook
# Listen for: checkout.session.completed,
#             customer.subscription.created,
#             customer.subscription.updated,
#             customer.subscription.deleted
